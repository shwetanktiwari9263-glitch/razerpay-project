# Backend runtime configuration. Spring Boot reads these as process environment
# variables; a local .env file is a convenient template, not an automatic loader.
SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://localhost:3306/recoverflow
DB_USERNAME=root
DB_PASSWORD=replace-with-local-password
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
ALLOW_UNSIGNED_WEBHOOKS=false
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
ML_SERVICE_ENABLED=true
ML_SERVICE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
